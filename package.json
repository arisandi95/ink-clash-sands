{
  "name": "inkclash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter @inkclash/server --filter @inkclash/web dev",
    "build:shared": "pnpm --filter @inkclash/shared build",
    "build": "pnpm build:shared && pnpm --filter @inkclash/server build && pnpm --filter @inkclash/web build",
    "start": "pnpm --filter @inkclash/server start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:contrast": "pnpm --filter @inkclash/web test:contrast",
    "e2e": "playwright test",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @inkclash/server db:migrate",
    "db:seed": "pnpm --filter @inkclash/server db:seed",
    "words:import": "pnpm --filter @inkclash/server words:import"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
